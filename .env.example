# Firebase Web SDK 설정값 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 카카오 로그인 - JavaScript 키 (Kakao Developers 내 애플리케이션 > 앱 키)
VITE_KAKAO_JS_KEY=

# 관리자 화면(/admin)에 접근 가능한 사용자 uid 목록 (쉼표로 구분)
# Firebase Console > Authentication > Users 에서 본인 UID 확인 후 등록
VITE_ADMIN_UIDS=

# 서버 전용 (Vercel Environment Variables 에만 등록, .env.local 에는 불필요)
# Firebase Admin 서비스 계정 JSON 을 base64 인코딩한 문자열
# Mac/Linux: cat service-account.json | base64 | tr -d '\n'
# 결과를 한 줄로 환경변수에 등록
# FIREBASE_SERVICE_ACCOUNT_KEY=

# 카카오 REST API 키 (Kakao Developers 내 애플리케이션 > 앱 키)
# KAKAO_REST_API_KEY=
