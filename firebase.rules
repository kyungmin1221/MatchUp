rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // users: 본인 문서만 쓰기, 모든 로그인 사용자 읽기 가능 (아바타/이름 표시용)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && userId == uid();
      allow update: if isSignedIn() && userId == uid();
      allow delete: if false;
    }

    // groups: 멤버만 read/update, 누구나 create
    match /groups/{groupId} {
      allow read: if isSignedIn() && uid() in resource.data.memberUids;
      allow create: if isSignedIn() && uid() in request.resource.data.memberUids;
      allow update: if isSignedIn() && (
        uid() in resource.data.memberUids ||
        // 초대코드로 가입: memberUids 에 본인만 추가하는 변경
        (request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
         request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([uid()])))
      );
      allow delete: if isSignedIn() && uid() == resource.data.ownerUid;
    }

    // polls: 그룹 멤버만 접근
    match /polls/{pollId} {
      function pollGroupMembers() {
        return get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids;
      }
      allow read: if isSignedIn() && uid() in pollGroupMembers();
      allow create: if isSignedIn() &&
        uid() in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids;
      allow update: if isSignedIn() && uid() in pollGroupMembers();
      allow delete: if isSignedIn() && uid() == resource.data.createdBy;
    }

    // matches: 그룹 멤버 + 상대팀 매치로 연결된 사용자 read 가능
    match /matches/{matchId} {
      function homeMembers() {
        return get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids;
      }
      function opponentMembers() {
        return resource.data.opponentMatchId == null ? [] :
          get(/databases/$(database)/documents/groups/$(
            get(/databases/$(database)/documents/matches/$(resource.data.opponentMatchId)).data.groupId
          )).data.memberUids;
      }
      allow read: if isSignedIn() && (uid() in homeMembers() || uid() in opponentMembers());
      allow create: if isSignedIn() &&
        uid() in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids;
      allow update: if isSignedIn() && uid() in homeMembers();
      allow delete: if isSignedIn() && uid() == resource.data.createdBy;
    }
  }
}
