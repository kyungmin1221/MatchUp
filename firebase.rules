rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function groupOwner(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid;
    }

    // users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && userId == uid();
      allow update: if isSignedIn() && userId == uid();
      allow delete: if false;
    }

    // groups: 멤버만 read/update, 누구나 create
    match /groups/{groupId} {
      allow read: if isSignedIn() && uid() in resource.data.memberUids;
      allow create: if isSignedIn() && uid() in request.resource.data.memberUids;
      allow update: if isSignedIn() && (
        uid() in resource.data.memberUids ||
        // 초대코드로 가입: memberUids 에 본인만 추가
        (request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
         request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([uid()])))
      );
      allow delete: if isSignedIn() && uid() == resource.data.ownerUid;
    }

    // polls: 그룹 멤버만 접근, 삭제는 그룹 owner만
    match /polls/{pollId} {
      function pollGroupMembers() {
        return get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids;
      }
      allow read: if isSignedIn() && uid() in pollGroupMembers();
      allow create: if isSignedIn() &&
        uid() in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids;
      allow update: if isSignedIn() && uid() in pollGroupMembers();
      allow delete: if isSignedIn() && uid() == groupOwner(resource.data.groupId);
    }

    // matches: home(그룹 멤버) OR away(awayMemberUids) 가 read/update.
    // 합류(awayMemberUids 에 본인 추가)는 awayInviteCode 가 존재하는 매치라면 누구나 가능.
    match /matches/{matchId} {
      function homeMembers() {
        return get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberUids;
      }
      function awayMembers() {
        return resource.data.awayMemberUids != null ? resource.data.awayMemberUids : [];
      }
      function isHomeOrAway() {
        return uid() in homeMembers() || uid() in awayMembers();
      }
      function isAwayJoinUpdate() {
        return resource.data.awayInviteCode != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awayMemberUids']) &&
          request.resource.data.awayMemberUids.hasAll(resource.data.awayMemberUids) &&
          request.resource.data.awayMemberUids.hasOnly(resource.data.awayMemberUids.concat([uid()]));
      }

      allow read: if isSignedIn() && isHomeOrAway();
      allow create: if isSignedIn() &&
        uid() in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberUids;
      allow update: if isSignedIn() && (isHomeOrAway() || isAwayJoinUpdate());
      allow delete: if isSignedIn() && uid() == groupOwner(resource.data.groupId);
    }
  }
}
